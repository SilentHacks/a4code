# Optional: A4 Connect source builds
# Local and direct connections do not need any of these settings.
# Use the public identifiers from your own Clerk instance and relay.
# Do not add server-side secrets to this file.
#
# A4CODE_CLERK_PUBLISHABLE_KEY=
# A4CODE_CLERK_JWT_TEMPLATE=
# A4CODE_CLERK_CLI_OAUTH_CLIENT_ID=

# Optional: signed macOS passkey builds. The RP domain defaults to the Frontend API
# hostname encoded in A4CODE_CLERK_PUBLISHABLE_KEY. Set the override only when Clerk
# returns a different RP ID or when multiple domains must be entitled.
# A4CODE_APPLE_TEAM_ID=
# A4CODE_MACOS_PROVISIONING_PROFILE=
# A4CODE_CLERK_PASSKEY_RP_DOMAINS=

# A4CODE_RELAY_URL=
# Hosted web origin, required for browser-based CLI Connect sign-in.
# A4CODE_HOSTED_APP_URL=

# Optional: fork-owned native signing and Expo update project.
# A4CODE_EXPO_OWNER=
# A4CODE_EAS_PROJECT_ID=
# A4CODE_CLERK_FRONTEND_API_HOST=

# Optional: fork-owned remote build cache.
# A4CODE_TASK_CACHE_ENDPOINT=

# Public, ingest-only mobile OpenTelemetry configuration.
# A4CODE_MOBILE_OTLP_TRACES_URL=
# A4CODE_MOBILE_OTLP_TRACES_DATASET=
# A4CODE_MOBILE_OTLP_TRACES_TOKEN=

# Optional product analytics. Set both values to enable an ingest destination.
# A4CODE_TELEMETRY_HOST=
# A4CODE_TELEMETRY_KEY=
